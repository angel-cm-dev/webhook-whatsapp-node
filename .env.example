# Puerto HTTP del receptor
PORT=3000

# Token que configuras en Meta for Developers > WhatsApp > Configuración > Webhook
WHATSAPP_VERIFY_TOKEN=cambia-este-token

# App Secret de tu app de Meta (Configuración > Básica). Se usa para validar X-Hub-Signature-256
WHATSAPP_APP_SECRET=tu-app-secret

# Ruta del webhook
WEBHOOK_PATH=/webhook
